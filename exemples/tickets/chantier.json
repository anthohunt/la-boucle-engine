{
  "nom": "ticket-triage",
  "banc": {"entrainement": "donnees/entrainement.jsonl", "examen": "donnees/examen.jsonl"},
  "harnais_depart": "harnais-0",
  "sujet": {"commande": ["python3", "sujet.py", "--lot"], "timeout_s": 60, "mode": "lot"},
  "comparateur": {
    "nom": "egalite",
    "options": {
      "cle": "etiquette",
      "matrice": {"urgent|rien": "interdit", "a_verifier|rien": "interdit", "a_verifier|urgent": "interdit"},
      "defaut": "tolere"
    }
  },
  "chercheur": {"commande": ["python3", "chercheur.py"], "timeout_s": 60},
  "parallelisme": 4,
  "largeur": 3,
  "tours_niveau1_max": 4,
  "passes_max": 8,
  "paliers": {"mode": "relatif", "pas": 10},
  "sequentiel": {"actif": true, "tranche": 15, "alpha": 0.05},
  "examen": {"gain_min": 5.0, "echecs_max": 2, "confirmation": true},
  "objectif": {"examen_min": 90.0}
}
